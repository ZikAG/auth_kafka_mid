            "description": "Permissions for token-exchange for client kafka-broker",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"token-exchange\"]",
              "scopes": "[\"token-exchange\"]",
              "applyPolicies": "[\"allow-token-exchange\"]"
            }
          }
        ],
        "scopes": [
          {
            "name": "token-exchange"
          }
        ],
        "decisionStrategy": "UNANIMOUS"
      }
