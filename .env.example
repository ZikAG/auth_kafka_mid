# Copy this file to .env and fill in values before running docker compose up -d

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KEYCLOAK_DB_PASSWORD=keycloak_password

# Kafka TLS
KAFKA_KEYSTORE_PASSWORD=kafka_keystore_password
KAFKA_KEY_PASSWORD=kafka_key_password
KAFKA_TRUSTSTORE_PASSWORD=kafka_truststore_password
KAFKA_BROKER_SECRET=kafka-broker-secret

# Auth Service clients
AUTH_SERVICE_CLIENT_SECRET=auth-service-secret
KAFKA_CLIENT_SECRET=kafka-client-secret

# Authorizer backend: custom | opa
AUTHORIZER_TYPE=custom

# Test users
ALICE_PASSWORD=alice_password
BOB_PASSWORD=bob_password
